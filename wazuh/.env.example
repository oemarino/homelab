# Copy to .env next to docker-compose.yml, chmod 600, owned by root.
# Generate long random values BEFORE first boot (the stock demo passwords must not be used),
# and set the same values in config/wazuh_indexer/internal_users.yml (bcrypt hashes) and
# config/wazuh_dashboard/wazuh.yml as described in the Wazuh docs.
INDEXER_PASSWORD=change-me-random-26-chars
DASHBOARD_PASSWORD=change-me-random-26-chars
API_PASSWORD=change-me-random-26-chars
# Interfaces to publish on (never 0.0.0.0)
LAN_IP=192.168.1.x
TAILSCALE_IP=100.x.y.z
